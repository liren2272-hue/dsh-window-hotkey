{
  "name": "@liren2272/dsh-hotkey",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: one global shortcut (Ctrl+Alt+Q) that minimizes the window and brings it back.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hotkey",
    "global-shortcut",
    "window",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liren2272-hue/dsh-window-hotkey.git"
  },
  "homepage": "https://github.com/liren2272-hue/dsh-window-hotkey#readme",
  "bugs": {
    "url": "https://github.com/liren2272-hue/dsh-window-hotkey/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "hotkey.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "scripts": {
    "test:parse": "node test/parse.test.mjs && cat test/parse-results.txt",
    "gen": "node test/gen.mjs && cat test/gen-status.txt"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
